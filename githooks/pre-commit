#!/bin/sh
# コミット前に src から .vlt をビルドし、更新があればステージする
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# リポジトリ名.vlt をビルド
python3 build-vlt.py
# 配布用の従来名もビルド（追跡中なら常に最新にしておく）
python3 build-vlt.py MinimalX_JPMod_VLC_2.6.2 2>/dev/null || true

# 更新された .vlt をステージ
git add *.vlt 2>/dev/null || true

exit 0
